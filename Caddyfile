# UAT-only TLS termination in front of the frontend/backend containers.
# `tls internal` uses Caddy's own local CA to mint a self-signed cert on
# the fly for whatever host/IP a client actually requests - deliberately
# port-only site addresses (no hostname) so it doesn't matter whether
# that's an IP, "localhost" (used by deploy-uat.yml's health check), or
# anything else; Entra just needs the *scheme* to be https, it doesn't
# validate the cert chain itself (the browser does, and will show a
# one-time "not trusted" warning here - expected for a self-signed cert
# on an internal UAT box, not something to fix unless this ever needs to
# be publicly trusted).
{
	auto_https disable_redirects
}

:3005 {
	tls internal
	reverse_proxy frontend:3005
}

:8005 {
	tls internal
	reverse_proxy backend:8005
}
