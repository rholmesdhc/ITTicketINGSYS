# UAT TLS termination in front of the frontend/backend containers, routed
# by hostname on standard ports (80/443) instead of the app's own custom
# ports (3005/8005) - lets people reach this over a normal-looking URL
# instead of an IP:port.
#
# `tls internal` uses Caddy's own local CA to mint a self-signed cert -
# dhc.org is an internal-only name (not a real public domain this box can
# prove ownership of via ACME), so a publicly-trusted cert isn't an
# option here. Entra just needs the *scheme* to be https, it doesn't
# validate the cert chain itself (the browser does, and will show a
# one-time "not trusted" warning to click through - expected, not a bug).
#
# default_sni matters for anyone still reaching this by raw IP instead of
# the hostname (deploy-uat.yml's health check included, until it's
# updated to use the real hostnames too) - TLS SNI doesn't apply to bare
# IP literals, so a client connecting to https://<ip> sends no SNI at
# all, and Caddy needs to be told which site to serve in that case.
{
	default_sni {$FRONTEND_HOST}
}

{$FRONTEND_HOST} {
	tls internal
	reverse_proxy frontend:3005
}

{$BACKEND_HOST} {
	tls internal
	reverse_proxy backend:8005
}
