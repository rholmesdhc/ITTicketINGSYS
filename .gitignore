# Python
__pycache__/
*.pyc
venv/
.venv/
*.db
*.sqlite

# env files (secrets) - never commit
.env
.env.*
# Bug fix: the pattern above was `!.env.*.example`, which only un-ignores
# a name like `.env.local.example` (something between the two dots) - it
# never matched the literal filename `.env.example` at all, so
# backend/.env.example (pure documentation, no real secrets) had been
# silently excluded from every commit since it was created.
!.env.example

# Node / Next.js
node_modules/
.next/
out/

# misc
*.log
.DS_Store

# Claude Code local project settings - a per-session/per-developer tool
# permission allowlist, not shared team config.
.claude/

# Contains real employee PII / password hashes from local seeding runs -
# must never be committed.
backend/seed_log.txt
backend/data/*.csv

# Ticket screenshot attachments - local dev storage (SCREENSHOT_UPLOAD_DIR
# default), same treatment as the seed CSV above. UAT uses a named Docker
# volume instead (docker-compose.uat.yml), not this directory.
backend/uploads/
