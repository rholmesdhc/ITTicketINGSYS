# Copy to .env for local dev (never commit the real .env - see .gitignore).
# Everything here has a working local-dev fallback baked into the code
# EXCEPT the ENTRA_* block, which has no sensible default - Entra login
# just won't work until these are set.

# --- Pre-existing (see database.py / auth.py / main.py for fallbacks) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/it_helpdesk2
# SECRET_KEY=change-me-generate-a-strong-random-key
# CORS_ORIGINS=http://localhost:3005

# --- Entra ID integration (see backend/entra_auth.py) ---
# Tenant ID shown on the Entra admin center's Overview page.
ENTRA_TENANT_ID=

# Client ID of the "IT Ticketing System - MCP Service" app registration
# (the machine identity used by mcp-server/, via the client-credentials
# grant - see mcp-server/.env for its client secret).
ENTRA_MCP_CLIENT_ID=

# Client ID of the "IT Ticketing System - Web" app registration. Doubles
# as the API the MCP service's token is issued for (api://<this-id>) -
# see "Expose an API" + "App roles" on that app registration.
ENTRA_WEB_APP_CLIENT_ID=

# Object IDs (not names) of the two security groups that drive role
# assignment on every Entra login - see Entra ID > Groups in the admin
# center. Anyone in neither group defaults to "requester".
ENTRA_ADMIN_GROUP_ID=
ENTRA_TECH_GROUP_ID=

# --- Email notifications (see backend/mailer.py) ---
# Left unset, notifications log to the console instead of sending (see
# mailer.CONFIGURED) - safe to leave blank for local dev.
#
# Required: Microsoft Graph API, app-only client-credentials (same pattern
# as ENTRA_MCP_CLIENT_ID above). Needs a dedicated app registration with
# the Mail.Send *application* permission, admin-consented, and ideally
# scoped via an Exchange Online New-ApplicationAccessPolicy to just the
# sending mailbox below - an unscoped Mail.Send grant can send as
# literally anyone in the tenant. This is the ONLY path confirmed to
# reliably deliver the real HTML notification templates - see the SMTP
# fallback's warning below before relying on it instead.
# ENTRA_MAIL_CLIENT_ID=
# ENTRA_MAIL_CLIENT_SECRET=
#
# Emergency fallback only, not equally reliable: SMTP relay, used only if
# the Graph vars above aren't set. A live side-by-side test on this
# project found that Direct Send (port 25, no auth, via
# <tenant>.mail.protection.outlook.com) accepts real HTML-templated
# notification emails at the SMTP level but silently drops them before
# delivery, while identical emails sent via Graph arrive fine - likely EOP
# spam filtering, root cause unconfirmed. Authenticated submission (port
# 587) is a separate, untested option if you have a real mailbox with
# Authenticated SMTP enabled and your tenant doesn't block SMTP AUTH
# tenant-wide (many now do by default).
# M365_SMTP_HOST=smtp.office365.com
# M365_SMTP_PORT=587
# M365_SMTP_USER=
# M365_SMTP_PASS=
#
# Used by both methods above:
# M365_FROM_NAME=Delta Health Center IT Helpdesk
# M365_FROM_ADDRESS=
# Base URL the "View Ticket" links in notification emails point at.
# FRONTEND_BASE_URL=http://localhost:3005
