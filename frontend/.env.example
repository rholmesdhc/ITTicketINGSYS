# Copy to .env.local for local dev (never commit the real file).

# Backend API base URL - defaults to http://localhost:8005 if unset.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8005

# --- NextAuth / Entra ID (see src/auth.ts) ---
# Generate with: npx auth secret
AUTH_SECRET=

# From the "IT Ticketing System - Web" app registration in Entra ID.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
