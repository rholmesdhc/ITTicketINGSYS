# Copy this to .env.uat on the UAT box and fill in real values.
# .env.uat is loaded by `docker compose --env-file .env.uat -f docker-compose.uat.yml ...`
# NEVER commit the real .env.uat - it's covered by .gitignore.

# --- GitHub / image registry ---
# Your GitHub username or org, lowercase (owns the ghcr.io images).
GHCR_OWNER=your-github-username
# Image tag to run. The deploy workflow overrides this to the pushed
# commit SHA; uat-latest is the fallback for manual `docker compose up`.
TAG=uat-latest

# --- Postgres (containerized) ---
POSTGRES_USER=ituser
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=it_helpdesk2

# --- Backend ---
# Absolute path on the UAT box holding the employee seed CSV
# (DHC_Employees_2.csv) - copy it there manually (scp), never via git.
# Bind-mounted read-only into the backend container's ./data dir.
SEED_DATA_DIR=/opt/it-ticketing/data

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-random-key
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://<ubuntu-box-ip>:3005

# --- Frontend ---
# NOTE: this is baked into the frontend image at BUILD time (Next.js
# inlines NEXT_PUBLIC_* vars into the client bundle), not read at
# container runtime. It's passed to `docker build --build-arg` by the
# deploy-uat.yml workflow, sourced from the GH repo variable of the same
# name - set that in GitHub → Settings → Secrets and variables →
# Actions → Variables, not here. Listed here only for reference.
# NEXT_PUBLIC_API_BASE_URL=http://<ubuntu-box-ip>:8005
