# Copy this to .env.uat on the UAT box and fill in real values.
# .env.uat is loaded by `docker compose --env-file .env.uat -f docker-compose.uat.yml ...`
# NEVER commit the real .env.uat - it's covered by .gitignore.

# --- TLS (see root Caddyfile) ---
# This box's real IP/hostname - used so Caddy can issue its self-signed
# cert eagerly for the right identity, and to handle plain-IP browser
# connections correctly (TLS SNI doesn't work with bare IP literals - see
# the Caddyfile's default_sni comment for why that matters here).
UAT_HOST=10.4.1.89

# --- GitHub / image registry ---
# Your GitHub username or org, lowercase (owns the ghcr.io images).
GHCR_OWNER=your-github-username
# Image tag to run. The deploy workflow overrides this to the pushed
# commit SHA; uat-latest is the fallback for manual `docker compose up`.
TAG=uat-latest

# --- Postgres (containerized) ---
POSTGRES_USER=ituser
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=it_helpdesk2

# --- Backend ---
# Absolute path on the UAT box holding the employee seed CSV
# (DHC_Employees_2.csv) - copy it there manually (scp), never via git.
# Bind-mounted read-only into the backend container's ./data dir.
SEED_DATA_DIR=/opt/it-ticketing/data

# # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-random-key
# Comma-separated list of origins allowed to call the API. https, not
# http - see the Caddy note near the bottom of this file for why.
CORS_ORIGINS=https://<ubuntu-box-ip>:3005

# --- Entra ID login (see backend/entra_auth.py) - same tenant/app
# registrations as local dev, copy straight from backend/.env there.
ENTRA_TENANT_ID=
ENTRA_MCP_CLIENT_ID=
ENTRA_WEB_APP_CLIENT_ID=
ENTRA_ADMIN_GROUP_ID=
ENTRA_TECH_GROUP_ID=

# --- Email notifications (see backend/mailer.py) - "IT Ticketing System
# - Mail Sender" app registration, copy from backend/.env.
ENTRA_MAIL_CLIENT_ID=
ENTRA_MAIL_CLIENT_SECRET=
M365_FROM_NAME=Delta Health Center IT Helpdesk
M365_FROM_ADDRESS=ithelpdesk@deltahealthcenter.org
# Base URL the "View Ticket" links in notification emails point at - the
# real UAT frontend URL, NOT localhost (that's only correct for local dev).
FRONTEND_BASE_URL=https://<ubuntu-box-ip>:3005

# --- Frontend ---
# NextAuth's own session-encryption secret (distinct from backend
# SECRET_KEY above) - generate with: npx auth secret
AUTH_SECRET=change-me-generate-a-strong-random-key

# Same Entra "IT Ticketing System - Web" app registration used for the
# backend's ENTRA_WEB_APP_CLIENT_ID above - copy from frontend/.env.local.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- TLS ---
# Entra flatly rejects plain http:// redirect URIs on anything other than
# exactly "http://localhost" - private IPs don't get an exception. See
# the root Caddyfile: a caddy service terminates TLS (self-signed, via
# Caddy's own internal CA) in front of both frontend and backend on their
# usual ports, so everything above needs to be https://, and your browser
# will show a one-time "not trusted" warning to click through - expected
# for a self-signed cert on an internal UAT box, not a bug.
#
# IMPORTANT: once this UAT box's real IP is decided, add it as a redirect
# URI on the "IT Ticketing System - Web" app registration in the Entra
# admin center (Authentication -> Redirect URIs) -
# https://<ubuntu-box-ip>:3005/api/auth/callback/microsoft-entra-id -
# alongside the localhost:3005 one already there for local dev. Entra
# login will fail with a redirect-URI-mismatch error until this is added.
# NOTE: NEXT_PUBLIC_API_BASE_URL below is baked into the frontend image at
# BUILD time (Next.js inlines NEXT_PUBLIC_* vars into the client bundle),
# not read at container runtime. It's passed to `docker build --build-arg`
# by the deploy-uat.yml workflow, sourced from the GH repo variable of the
# same name - set that in GitHub → Settings → Secrets and variables →
# Actions → Variables, not here. Listed here only for reference.
# NEXT_PUBLIC_API_BASE_URL=https://<ubuntu-box-ip>:8005
